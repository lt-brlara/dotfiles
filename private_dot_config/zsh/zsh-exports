# XDG
export XDG_CONFIG_HOME=$HOME/.config
export XDG_DATA_HOME=$HOME/.local/share
export XDG_CACHE_HOME=$HOME/.cache

# Redundant for clarity
export ZDOTDIR=$XDG_CONFIG_HOME/zsh/

# PATH priority for brew
export PATH=/opt/homebrew/bin:$PATH
export PATH=/usr/local/bin/brew:$PATH

if type brew &>/dev/null
then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"

  autoload -Uz compinit
  compinit
fi

# Path modifications
export PATH=$PATH:/usr/local/go/bin
export PATH=$PATH:/home/linuxbrew/.linuxbrew/bin
export PATH=$PATH:/home/blara/.local/bin
export PATH=/usr/local/sbin:$PATH
export PATH=/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin:$PATH
export PATH=/opt/homebrew/bin:$PATH
export PATH=/usr/local/bin/brew:$PATH
export PATH=/home/linuxbrew/.linuxbrew/lib/ruby/gems/3.1.0/bin:$PATH
export PATH=$XDG_DATA_HOME/gem/ruby/3.1.0/bin:$PATH
export PYENV_ROOT="$HOME/.pyenv"

export EDITOR=nvim

# GPG

export KEYID=0x82BA88A402D9EF28
export GPG_TTY="$(tty)"
export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)

# Go
export GOPATH=$HOME/go
export GOBIN=$GOPATH/bin
export GO=$GOPATH/src/github.com/brlara
export PATH=$PATH:$GOPATH/bin

# Rust
export PATH=$HOME/.cargo/bin:$PATH

# vim config
export VIM_CONFIG=$HOME/.vimrc

# nvim config
export NVIM_CONFIG=$XDG_CONFIG_HOME/nvim/

# GPG Agent Forwarding
export GPG_TTY=$TTY
export SSH_AUTH_SOCK=$(gpgconf --list-dirs agent-ssh-socket)

# GKE v1.25+ auth plugin
export USE_GKE_GCLOUD_AUTH_PLUGIN=True

# Azure CLI disable telemetry
export DOTNET_CLI_TELEMETRY_OPTOUT=1

# Obsidian
export OBSIDIAN_DIR=$HOME/Documents/Obsidian

# NPM config
export NPM_CONFIG_USERCONFIG=$XDG_CONFIG_HOME/npm/npmrc

export PATH=$PATH:$XDG_DATA_HOME/npm/bin

# GnuPG home
export GNUPGHOME=$XDG_DATA_HOME/gnupg

# Minikube home
export MINIKUBE_HOME=$XDG_DATA_HOME/minikube

# Zsh-z settings
ZSHZ_EXCLUDE_DIRS=( /var /usr /etc )
