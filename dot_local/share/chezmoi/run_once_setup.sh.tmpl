#!/bin/sh

# Only runs once per machine during `chezmoi apply`

set -e

# Log functions
log()      { echo "[INFO] $1";  }
logwarn()  { echo "[WARN] $1";  }
logerror() { echo "[ERROR] $1"; }

main() {
  log "Starting first-time setup..."
  cd $HOME
  
  install_core_packages
  config_shell
  build_and_install_nvim
}

config_shell() {
  log "Configuring shell..."
  sudo chsh blara -s "$(command -v zsh)"
  log "Shell successfully configured!"
}

install_core_packages() {
  log "Installing core packages..."
  {{ if eq .chezmoi.os "linux" -}}
  {{ if eq .chezmoi.osRelease.id "debian" "ubuntu" -}}
  sudo apt-get update > /dev/null 2>&1
  {{ range .packages.linux.apt -}}
  sudo apt-get install {{ . | quote }} -y >/dev/null 2>&1
  {{ end -}}
  {{ end -}}
  {{ end -}}

  install_eza

  log "Core packages installed!"
}

install_eza() {
  {{ if eq .chezmoi.os "linux" -}}
  {{ if eq .chezmoi.osRelease.id "debian" "ubuntu" -}}
  sudo mkdir -p /etc/apt/keyrings
  wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
  echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
  sudo chmod 644 /etc/apt/keyrings/gierens.gpg /etc/apt/sources.list.d/gierens.list
  sudo apt update > /dev/null 2>&1
  sudo apt install -y eza > /dev/null 2>&1
  {{ end -}}
  {{ end -}}
}

build_and_install_nvim() {
  log "Installing nvim"
  
  NEOVIM_DIR="$HOME/ghq/github.com/neovim/neovim"
  
  log "🔍 Checking build dependencies..."
  
  sudo apt update
  sudo apt install -y \
    ninja-build gettext cmake unzip curl \
    build-essential git libtool libtool-bin \
    autoconf automake pkg-config
  
  log "📁 Ensuring build directory exists..."
  mkdir -p "$HOME/ghq/github.com/neovim"
  
  if [ ! -d "$NEOVIM_DIR" ]; then
    log "📥 Cloning Neovim repo..."
    git clone https://github.com/neovim/neovim.git "$NEOVIM_DIR"
  else
    warn "📦 Neovim source already exists, updating..."
    git -C "$NEOVIM_DIR" pull
  fi
  
  cd "$NEOVIM_DIR"
  
  log "🛠️ Building Neovim..."
  make CMAKE_BUILD_TYPE=Release > /dev/null 2>&1
  
  log "🚀 Installing Neovim..."
  sudo make install > /dev/null 2>&1
  
  log "✅ Neovim installed to: $(command -v nvim)"
  nvim --version | head -n 1
  
  log "neovim installed!"
}

main
