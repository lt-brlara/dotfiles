#!/bin/bash
# Only runs once per machine during `chezmoi apply`

set -e
LOGFILE="$HOME/setup.log"
mkdir -p "$(dirname "$LOGFILE")"
: > "$LOGFILE"  # clear previous log

# Log functions
_ts() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

log()      { printf "[%s INFO]  %s\n" "$(_ts)" "$1" | tee -a "$LOGFILE"; }
logwarn()  { printf "[%s WARN]  %s\n" "$(_ts)" "$1" | tee -a "$LOGFILE"; }
logerror() { printf "[%s ERROR] %s\n" "$(_ts)" "$1" | tee -a "$LOGFILE" >&2; }

main() {
  log "🛫 Starting first-time setup..."
  cd "$HOME"

  log "🔐 Requesting sudo access..."
  sudo -v
  log "✅ Access granted!"

 
  log "🏁 Setup complete!"
}
